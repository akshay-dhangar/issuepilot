# Copy values into your shell; the server does not automatically load .env.
HTTP_ADDR=127.0.0.1:8080
# Optional: omitted means ephemeral demo mode.
DATABASE_URL=postgres://issuepilot:localdev@localhost:5432/issuepilot?sslmode=disable

# Model repair CLI only; never commit an actual key.
OPENAI_API_KEY=

# Server repair mode: all required alongside DATABASE_URL and OPENAI_API_KEY.
# Generate a random token; leave blank for unauthenticated local demo mode.
ISSUEPILOT_API_TOKEN=
ISSUEPILOT_MODEL=
ISSUEPILOT_REPOSITORIES=
